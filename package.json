{
  "name": "business-logic-mcp",
  "version": "1.0.0",
  "description": "Logic aid for software development - An MCP server that exposes business rules, state machines, field semantics, and known footguns to LLMs during code generation.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "business-logic-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node --esm src/index.ts"
  },
  "keywords": [
    "mcp",
    "business-logic",
    "llm",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
